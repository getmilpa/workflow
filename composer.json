{
  "name": "milpa/workflow",
  "description": "ORM-backed data-driven state machine for the Milpa PHP framework: states, transitions and approval gates with evidence, plus a VerifierInterface bridge into the core verification seam.",
  "type": "library",
  "license": "Apache-2.0",
  "authors": [
    {
      "name": "Rodrigo Vicente - TeamX Agency",
      "homepage": "https://teamx.agency"
    }
  ],
  "require": {
    "php": ">=8.3",
    "milpa/core": "^0.6",
    "doctrine/orm": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpdoc-parser": "^2.3",
    "friendsofphp/php-cs-fixer": "^3.65",
    "doctrine/dbal": "^4.0",
    "symfony/cache": "^7.0",
    "phpstan/phpstan-doctrine": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "Milpa\\Workflow\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Milpa\\Workflow\\Tests\\": "tests/",
      "Milpa\\Docs\\": "vendor/milpa/core/tools/gen-docs/"
    }
  }
}
